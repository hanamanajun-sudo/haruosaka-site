---
import { CATEGORY_SLUGS } from '../lib/categories';

interface Props {
  siteName: string;
}
const { siteName } = Astro.props;

const navCategories = [
  '일본 생활',
  '일본 생활/요리 레시피',
  '한국 생활정보',
  '해외토픽',
  '드라마-영화 리뷰',
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <span class="brand-stamp">日</span>
      <span class="brand-text">
        <span class="brand-title">{siteName}</span>
        <span class="brand-sub">Osaka Life Journal</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="카테고리">
      <ul>
        {navCategories.map((cat) => (
          <li><a href={`/category/${CATEGORY_SLUGS[cat]}/`}>{cat.split('/').pop()}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 2px dashed var(--line);
    background: var(--paper-deep);
    padding: 1.1rem 0;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand:hover {
    color: var(--ink);
  }
  .brand-stamp {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 2px solid var(--hanko);
    border-radius: 50%;
    color: var(--hanko);
    font-family: var(--font-display);
    font-size: 1.15rem;
    transform: rotate(-8deg);
    flex-shrink: 0;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
  }
  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    text-transform: uppercase;
  }
  .site-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
  }
  .site-nav a:hover {
    color: var(--hanko);
    border-bottom-color: var(--hanko);
  }
  @media (max-width: 640px) {
    .site-nav ul {
      gap: 0.9rem 1.1rem;
    }
    .site-nav a {
      font-size: 0.85rem;
    }
  }
</style>
