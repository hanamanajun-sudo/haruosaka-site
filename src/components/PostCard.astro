---
import { categorySlug } from '../lib/categories';

interface Props {
  slug: string;
  title: string;
  date: string;
  category?: string;
  description?: string;
  thumbnail?: string;
  index?: number;
}
const { slug, title, date, category, description, thumbnail, index = 0 } = Astro.props;
const catSlug = category ? categorySlug(category) : null;
const delay = Math.min(index, 8) * 0.05;
---

<a href={`/entry/${slug}/`} class="post-card" style={`animation-delay:${delay}s`}>
  <div class="thumb-frame">
    {thumbnail ? (
      <img src={thumbnail} alt={title} loading="lazy" />
    ) : (
      <div class="thumb-fallback" aria-hidden="true">日</div>
    )}
  </div>
  <div class="card-body">
    {category && (
      <span class="hanko-badge">{category.split('/').pop()}</span>
    )}
    <h3 class="card-title">{title}</h3>
    {description && <p class="card-desc">{description}</p>}
    <time class="card-date" datetime={date}>{date}</time>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    gap: 1.1rem;
    text-decoration: none;
    color: inherit;
    background: #fffdf8;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem;
    box-shadow: 0 3px 0 -1px var(--paper), 0 5px 14px var(--paper-shadow);
    opacity: 0;
    animation: rise 0.5s ease forwards;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .post-card:hover {
    transform: translateY(-3px) rotate(-0.3deg);
    box-shadow: 0 3px 0 -1px var(--paper), 0 12px 22px var(--paper-shadow);
    color: inherit;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .thumb-frame {
    flex-shrink: 0;
    width: 108px;
    height: 108px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--paper-deep);
    outline: 1.5px dashed var(--line);
    outline-offset: 3px;
  }
  .thumb-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: var(--paper-deep);
    color: var(--hanko);
    font-family: var(--font-display);
    font-size: 1.8rem;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .card-title {
    font-size: 1.08rem;
    margin: 0;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .card-desc {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .card-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    margin-top: auto;
  }
  @media (max-width: 480px) {
    .thumb-frame {
      width: 76px;
      height: 76px;
    }
  }
</style>
