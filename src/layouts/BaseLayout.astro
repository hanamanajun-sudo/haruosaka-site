---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = '일본에 살고 있는 한국인이 전하는 일본 생활, 요리 레시피, 한국-일본 생활정보 이야기.',
  image,
  type = 'website',
  noindex = false,
} = Astro.props;

const SITE_NAME = '하루짱 다이어리';
const pageTitle = title === SITE_NAME ? title : `${title} - ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : new URL('/og-default.svg', Astro.site).toString();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="ko_KR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 검색엔진 소유확인 (구 haruosaka.tistory.com에서 이식) -->
    <meta name="google-site-verification" content="i_uC8RSsjsJRq3k8cJf85Fsa20seZolMNMdtRRpzVew" />
    <meta name="google-site-verification" content="8vweZoYIYHsV8uXwGWWPFFNKo9tMD957TTHbB3N3USQ" />
    <meta name="naver-site-verification" content="596bb322331f1e0fccaea6d8a6545393f935ef42" />

    <slot name="head" />
  </head>
  <body>
    <Header siteName={SITE_NAME} />
    <main class="wrap">
      <slot />
    </main>
    <Footer siteName={SITE_NAME} />
  </body>
</html>
