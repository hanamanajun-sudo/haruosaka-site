---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORY_SLUGS, SLUG_TO_CATEGORY } from '../../lib/categories';

export async function getStaticPaths() {
  return Object.values(CATEGORY_SLUGS).map((slug) => ({ params: { category: slug } }));
}

const { category: slug } = Astro.params;
const categoryName = SLUG_TO_CATEGORY[slug!];

const posts = (await getCollection('posts'))
  .filter((p) => p.data.category === categoryName && !p.data.noindex)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout title={categoryName} description={`${categoryName} 카테고리 글 모음`}>
  <section class="category-hero">
    <span class="hanko-badge">{categoryName}</span>
    <h1>{categoryName}</h1>
    <p class="count">{posts.length}개의 글</p>
  </section>

  <hr class="dotted-rule" />

  <section class="post-grid" aria-label={`${categoryName} 글 목록`}>
    {posts.map((post, i) => (
      <PostCard
        slug={post.data.slug}
        title={post.data.title}
        date={post.data.date}
        category={post.data.category}
        description={post.data.description}
        thumbnail={post.data.thumbnail}
        index={i}
      />
    ))}
  </section>

  {posts.length === 0 && <p class="empty">아직 이 카테고리에 글이 없어요.</p>}
</BaseLayout>

<style>
  .category-hero {
    padding: 2.5rem 0 1rem;
    text-align: center;
  }
  .category-hero h1 {
    margin: 0.7rem 0 0.3rem;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding-bottom: 3rem;
  }
  @media (min-width: 720px) {
    .post-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .empty {
    text-align: center;
    color: var(--ink-soft);
    padding: 2rem 0 4rem;
  }
</style>
